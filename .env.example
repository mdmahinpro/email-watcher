# Copy to .env and fill in. Never commit the real .env.

# ---------------------------------------------------------------------------
# Access control  (REQUIRED — the app refuses every request without it)
# ---------------------------------------------------------------------------
# Local development — writes both values into this file:
#   pnpm --filter @workspace/scripts run set-password
#
# Deploying to a host (Render etc.) — prints the values to paste into the
# dashboard, writing nothing to disk:
#   pnpm --filter @workspace/scripts run hash-password
#
# The password is hashed with scrypt, so the plaintext is never stored. Changing
# the password invalidates all existing sessions.
# APP_PASSWORD_HASH=scrypt$65536$8$1$<salt-hex>$<hash-hex>
# SESSION_SECRET=<48 random bytes, base64url>

# Send session cookies without the Secure attribute. ONLY for local plain-HTTP
# development: on a real domain this would let the session be sent over http and
# stolen in transit. Leave unset in production.
# AUTH_INSECURE_COOKIES=true

# Number of reverse-proxy hops in front of the app (nginx/Caddy = 1,
# Cloudflare + nginx = 2). Required for the login rate limiter to see real client
# IPs. Leave unset when nothing proxies the app: trusting these headers without a
# proxy lets a client spoof its IP and defeat the limiter.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local Postgres (see docker-compose.yml):
DATABASE_URL=postgres://emailwatcher:emailwatcher_dev@localhost:5432/emailwatcher

# Supabase — Project settings > Database > Connection string > "Connection
# pooling" (Transaction mode, port 6543). Use the pooler, not the direct 5432
# connection: it survives provider restarts better for a long-running server.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Do NOT use Render's own free Postgres: it is deleted 30 days after creation
# regardless of activity.
#
# TLS is enabled automatically for any non-local host. To require full
# certificate verification instead, append ?sslmode=verify-full&sslrootcert=/path/to/ca.crt
#
# Client-side pool size. Keep small on Supabase's transaction pooler and on a
# 512 MB free instance. 5 is a good default there; 10 is the built-in default.
# DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
# Optional locally (defaults to 3001). A managed host injects this itself.
PORT=3001

# Comma-separated browser origins allowed to call the API. In production the SPA
# is served from this same server, so this only needs the app's own origin.
# FRONTEND_ORIGINS=https://email-watcher.onrender.com

# Where the built SPA lives. Auto-detected from artifacts/web/dist/public; set
# only if your deployment lays the files out elsewhere.
# STATIC_DIR=/opt/render/project/src/artifacts/web/dist/public

# trace | debug | info | warn | error
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Web dev server (optional)
# ---------------------------------------------------------------------------
# Where Vite proxies /api during development. Defaults to http://localhost:3001.
# API_PROXY_TARGET=http://localhost:3001
